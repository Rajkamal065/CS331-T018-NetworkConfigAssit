# ── LLM Provider Configuration ─────────────────────────────────
# Supported providers: claude, groq, openrouter, ollama
#
# RECOMMENDED: Ollama (Free, Local, No API Key Needed)
# Setup: Download from https://ollama.ai, then run: ollama pull llama3.1
# Then start Ollama in another terminal: ollama serve
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ── Alternative: Groq (Free Tier, Very Fast) ──────────────────
# Get free API key at: https://console.groq.com
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=your_free_key_here

# ── Alternative: Anthropic Claude (Paid, Recommended Quality) ───
# Get API key at: https://console.anthropic.com
# LLM_PROVIDER=claude
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your_api_key_here

# ── Alternative: OpenRouter (Free Tier Available) ──────────────
# Get free API key at: https://openrouter.ai
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_API_KEY=your_free_key_here
